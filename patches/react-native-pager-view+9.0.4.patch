+/// `UIHostingController` makes SwiftUI install its `UIKitNavigationBarBridge`,
+/// which calls `-[UINavigationController setNavigationBarHidden:NO]` on the
+/// enclosing navigation controller whenever the hosting view appears
+/// (observed on iOS 15). When that navigation controller deliberately keeps its
+/// bar hidden — e.g. the one react-native-screens creates for `hasTwoStates`
+/// tab/drawer containers — the bridge re-shows an empty `UINavigationBar` that
+/// then swallows touches meant for the React Native views underneath.
+/// Preserve the previous visibility across the appearance callback.
+final class PagerHostingController<Content: View>: UIHostingController<Content> {
+  override func viewWillAppear(_ animated: Bool) {
+    let navigationController = enclosingNavigationController
+    let wasNavigationBarHidden = navigationController?.isNavigationBarHidden == true
+    super.viewWillAppear(animated)
+    if wasNavigationBarHidden {
+      navigationController?.setNavigationBarHidden(true, animated: false)
+    }
+  }
+
+  private var enclosingNavigationController: UINavigationController? {
+    if let navigationController {
+      return navigationController
+    }
+
+    var viewController: UIViewController? = self
+    while let current = viewController {
+      if let navigationController = current as? UINavigationController {
+        return navigationController
+      }
+      viewController = current.parent
+    }
+
+    return nil
+  }
+}
+
